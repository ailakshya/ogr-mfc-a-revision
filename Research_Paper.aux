\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Modality Visualization.} (a) Representative low-resolution vision inputs. (b) Typical spectrogram showing the temporal complexity of the audio signal. The disparity in information density (Spatial vs. Temporal) drives the Modality Laziness phenomenon.}}{4}{figure.caption.6}\protected@file@percent }
\newlabel{fig:modalities}{{2}{4}{\textbf {Modality Visualization.} (a) Representative low-resolution vision inputs. (b) Typical spectrogram showing the temporal complexity of the audio signal. The disparity in information density (Spatial vs. Temporal) drives the Modality Laziness phenomenon}{figure.caption.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \textbf  {Quantitative Benchmark Results.} Best validation accuracy, OGR Gap (the absolute difference between Vision and Audio OGR averaged over the final 5 epochs—lower means more balanced), and Robustness (accuracy when Gaussian noise $\sigma {=}1.0$ is injected into visual inputs). All numbers are from a controlled single-run experiment on the synthetic CIFAR-10/CREMA-D feature benchmark. MFC reduces the imbalance gap by \textbf  {32\%} over the naive baseline and matches OGM-GE's robustness without any noise injection.}}{4}{table.caption.7}\protected@file@percent }
\newlabel{tab:results}{{4}{4}{\textbf {Quantitative Benchmark Results.} Best validation accuracy, OGR Gap (the absolute difference between Vision and Audio OGR averaged over the final 5 epochs—lower means more balanced), and Robustness (accuracy when Gaussian noise $\sigma {=}1.0$ is injected into visual inputs). All numbers are from a controlled single-run experiment on the synthetic CIFAR-10/CREMA-D feature benchmark. MFC reduces the imbalance gap by \textbf {32\%} over the naive baseline and matches OGM-GE's robustness without any noise injection}{table.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Training Curves.} Top-left: validation accuracy over 30 epochs. Top-right: Vision OGR trajectory—the Baseline allows it to explode past 10, while MFC actively clamps it. Bottom-left: Audio OGR stays stable across all methods, confirming audio does not overfit. Bottom-right: MFC's dynamic weights ($\lambda _v$ drops from 1.22 to 0.39 as vision overfits; $\lambda _a$ rises to 1.55 to compensate).}}{5}{figure.caption.8}\protected@file@percent }
\newlabel{fig:accuracy}{{3}{5}{\textbf {Training Curves.} Top-left: validation accuracy over 30 epochs. Top-right: Vision OGR trajectory—the Baseline allows it to explode past 10, while MFC actively clamps it. Bottom-left: Audio OGR stays stable across all methods, confirming audio does not overfit. Bottom-right: MFC's dynamic weights ($\lambda _v$ drops from 1.22 to 0.39 as vision overfits; $\lambda _a$ rises to 1.55 to compensate)}{figure.caption.8}{}}
