\@writefile{toc}{\contentsline {subsection}{\numberline {5.7}Robustness Analysis}{6}{subsection.5.7}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces \textbf  {Robustness to Visual Noise.} Accuracy (on the held-out validation set) as Gaussian noise of increasing standard deviation $\sigma $ is added to the visual input at test time. Clean audio is always available. The MFC and OGM-GE both achieve notably better resilience than the Baseline at moderate noise levels ($\sigma \leq 1.0$), confirming that their audio encoders have learned genuinely useful features rather than remaining dormant.}}{6}{table.caption.12}\protected@file@percent }
\newlabel{tab:robustness}{{7}{6}{\textbf {Robustness to Visual Noise.} Accuracy (on the held-out validation set) as Gaussian noise of increasing standard deviation $\sigma $ is added to the visual input at test time. Clean audio is always available. The MFC and OGM-GE both achieve notably better resilience than the Baseline at moderate noise levels ($\sigma \leq 1.0$), confirming that their audio encoders have learned genuinely useful features rather than remaining dormant}{table.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Benchmark Summary.} Left: Best validation accuracy per method. Centre: OGR Gap (lower = more balanced training). Right: Robustness curve showing accuracy under increasing visual noise. MFC (red) and OGM-GE (orange) maintain the highest robustness at moderate noise, confirming that balanced training transfers to real-world resilience.}}{6}{figure.caption.13}\protected@file@percent }
\newlabel{fig:robustness}{{5}{6}{\textbf {Benchmark Summary.} Left: Best validation accuracy per method. Centre: OGR Gap (lower = more balanced training). Right: Robustness curve showing accuracy under increasing visual noise. MFC (red) and OGM-GE (orange) maintain the highest robustness at moderate noise, confirming that balanced training transfers to real-world resilience}{figure.caption.13}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.8}Real-World Validation: CREMA-D Corpus}{6}{subsection.5.8}\protected@file@percent }
\citation{ogm_ge}
\citation{audioset}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces \textbf  {Real-Data Benchmark: CREMA-D Emotion Recognition.} MFC achieves the highest test accuracy and the best robustness at $\sigma {=}1.0$. OGM-GE achieves the lowest OGR gap (5.91) through aggressive noise injection but suffers a \textbf  {$-$3.1\%} accuracy penalty—confirming the over-correction problem. MFC reduces the OGR gap by 38.9\% over the Baseline with no accuracy cost.}}{7}{table.caption.14}\protected@file@percent }
\newlabel{tab:crema}{{8}{7}{\textbf {Real-Data Benchmark: CREMA-D Emotion Recognition.} MFC achieves the highest test accuracy and the best robustness at $\sigma {=}1.0$. OGM-GE achieves the lowest OGR gap (5.91) through aggressive noise injection but suffers a \textbf {$-$3.1\%} accuracy penalty—confirming the over-correction problem. MFC reduces the OGR gap by 38.9\% over the Baseline with no accuracy cost}{table.caption.14}{}}
